generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  passwordHash   String
  role           UserRole         @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  quizzesCreated Quiz[]
  assignments    QuizAssignment[]
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  DROPDOWN
  FILL_BLANK
  MATCHING
}

model Quiz {
  id               String     @id @default(cuid())
  title            String
  description      String?
  topicId          String?
  createdById      String
  timeLimitMinutes Int?
  startsAt         DateTime?
  deadline         DateTime?
  status           QuizStatus @default(DRAFT)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  createdBy   User             @relation(fields: [createdById], references: [id])
  questions   Question[]
  assignments QuizAssignment[]

  @@index([createdById])
  @@index([topicId])
  @@index([status])
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  text          String
  options       Json?
  correctAnswer Json
  marks         Int          @default(1)
  explanation   String?
  order         Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model QuizAssignment {
  id            String   @id @default(cuid())
  quizId        String
  userId        String?
  assignedToAll Boolean  @default(false)
  examId        String?
  assignedAt    DateTime @default(now())

  quiz Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@unique([quizId, userId])
  @@index([userId])
}
