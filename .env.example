# ArcCore — Environment Variables
# ================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arccore"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-32-plus-byte-secret"

# ---------------------------------------------------------------------------
# Default Admin Account (required)
# ---------------------------------------------------------------------------
# This admin account is auto-created on first server start if it doesn't exist.
# Change these before deploying to production.
ADMIN_EMAIL="admin@arccore.app"
ADMIN_PASSWORD="Admin@StrongPassword1"
ADMIN_NAME="ArcCore Admin"
