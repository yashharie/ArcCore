# ArcCore — Environment Variables
# ================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string for Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arccore"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Secret key used to sign JWT session tokens.
# Must be a random string of at least 32 bytes.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-random-32-plus-byte-secret"
